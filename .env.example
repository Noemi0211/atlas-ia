# ============================================================
# Atlas IA — Variables de entorno
# ============================================================
# Copia este archivo como .env y rellena los valores.

# --- Base de datos (Prisma + PostgreSQL / Neon) ---
# DATABASE_URL: URL de conexión en CALIENTE (pooled) para la aplicación
# (Vercel/Next.js en runtime). En Neon es la que termina en "-pooler".
# Debe incluir ?sslmode=require&pgbouncer=true&connection_limit=1
# DIRECT_URL: URL de conexión DIRECTA (sin pooler) para Prisma CLI
# (migraciones: migrate dev / migrate deploy / studio).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.production.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.production.neon.tech/DBNAME?sslmode=require"

# --- NextAuth.js ---
# IMPORTANTE: en producción usa un secreto fuerte y único
# (p. ej. generado con: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
NEXTAUTH_SECRET="atlas-ia-super-secret-key-change-in-production"
NEXTAUTH_URL="https://atlas-ia.dev"

# --- Panel docente ---
# Correos separados por comas. Los usuarios registrados con
# estos correos obtienen el rol "teacher" automáticamente.
# Debe incluir el correo de la autora para ver las valoraciones
# y propuestas de toda la prueba piloto.
TEACHER_EMAILS="profesor@correo.com"

# --- OpenAI (opcional) ---
# Si se define, el chat del laboratorio usa gpt-4o-mini.
# Si no, funciona con el sistema de respuestas offline.
# OPENAI_API_KEY="sk-..."

# --- Sentry — Monitorización de errores (opcional) ---
# Si SENTRY_DSN no está definido, Sentry queda desactivado.
# SENTRY_DSN="https://...@sentry.io/..."
# SENTRY_ORG="tu-org"          # slug de la organización en Sentry
# SENTRY_PROJECT="atlas-ia"    # slug del proyecto en Sentry
# SENTRY_AUTH_TOKEN="sntrys_..." # token para subir sourcemaps (build CI)
